# App URLs
NEXT_PUBLIC_APP_URL=https://inkdown.example.com
NEXT_PUBLIC_SITE_URL=https://inkdown.example.com
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Neon Postgres (metadata + Better Auth tables)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-secret-at-least-32-chars

# Cloudflare R2 (markdown content storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=inkdown-content

# Resend (auth emails: verification + password reset)
# Free tier: 3,000 emails/month, 100/day — https://resend.com/pricing
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Inkdown <noreply@inkdown.example.com>
# Optional: public HTTPS origin for email asset fallbacks (defaults to app URL, never localhost)
# AUTH_EMAIL_ASSET_BASE_URL=https://inkdown.example.com