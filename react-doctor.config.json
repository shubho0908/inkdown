{
  "diff": false,
  "failOn": "warning",
  "exclude": [".next/**"],
  "ignore": {
    "overrides": [
      {
        "files": [
          "app/opengraph-image.tsx",
          "app/twitter-image.tsx",
          "app/view/**/opengraph-image.tsx",
          "app/view/**/twitter-image.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": ["lib/email/auth-email-template.tsx"],
        "rules": ["react-doctor/nextjs-no-img-element", "react-doctor/control-has-associated-label"]
      },
      {
        "files": [".next/**"],
        "rules": ["deslop/unused-file"]
      }
    ]
  }
}
