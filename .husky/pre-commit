#!/usr/bin/env bash
set -e

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Pre-commit checks"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ── 1. Auto-format staged files ─────────────────────────────────────────────
echo ""
echo "▶ Formatting staged files…"
bunx lint-staged --config lint-staged.config.mjs

# Re-stage any files prettier/eslint modified
git add -u

# ── 2. API guardrails ───────────────────────────────────────────────────────
echo ""
echo "▶ API guardrails…"
bun run guard:api

# ── 3. Lint ─────────────────────────────────────────────────────────────────
echo ""
echo "▶ Linting…"
bun run lint

# ── 4. Type check ───────────────────────────────────────────────────────────
echo ""
echo "▶ Type checking…"
bun run typecheck

# ── 5. Build ────────────────────────────────────────────────────────────────
echo ""
echo "▶ Building…"
bun run build

# ── 6. React Doctor score (must be 100) ───────────────────────────────────
echo ""
echo "▶ React Doctor health check…"
bun scripts/check-react-doctor-score.mjs

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  All checks passed ✓"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
